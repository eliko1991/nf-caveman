/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-caveman Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs if not overwritten
params {
    // Input options (matching toil_caveman parameter names)
    tumour_bam             = null
    normal_bam             = null
    reference              = null  // Path to reference.fa.fai

    // Copy number files
    normal_cn              = null
    tumour_cn              = null
    norm_cn_default        = null
    tum_cn_default         = null

    // Species/assembly
    species                = 'Human'
    species_assembly       = 'GRCh37'

    // Sequencing type: 'genomic' (WGS) or 'pulldown' (exome/targeted)
    seqType                = 'genomic'

    // Protocol
    normal_protocol        = 'WGS'
    tumour_protocol        = 'WGS'

    // Platform overrides. CaVEMan aborts when the tumour and normal @RG PL values differ
    // (src/output.c). Setting both to the same string satisfies that check without patching
    // the source, which is what the papaemmelab CaVEMan fork used to do.
    normal_platform        = null
    tumour_platform        = null

    // Flagging/annotation files
    annot_bed_files        = null
    flag_bed_files         = null
    germline_indel         = null
    ignore_file            = null
    unmatched_vcf          = null

    // Flagging config files
    flagConfig             = null
    flagToVcfConfig        = null

    // Contamination
    normal_contamination   = null

    // Resource options
    max_memory_usage       = '5.GB'
    bin_size               = 10000

    // TGD mode (reduced resources for targeted data)
    tgd                    = false

    // Output options
    outdir                 = './results'
    publish_dir_mode       = 'copy'
    tracedir               = "${params.outdir}/pipeline_info"

    // Max resource options (nf-core standard)
    max_cpus               = 16
    max_memory             = '128.GB'
    max_time               = '240.h'

    // Boilerplate options
    help                   = false
    version                = false
    monochrome_logs        = false
    validate_params        = true
    show_hidden_params     = false
    schema_ignore_params   = 'genomes'

    // Config options
    custom_config_version  = 'master'
    custom_config_base     = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_name    = null
    config_profile_description = null
    config_profile_contact = null
    config_profile_url     = null
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load modules.config for DSL2 module options
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/singularity_cache"
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        singularity.envWhitelist = 'SINGULARITY_BINDPATH,SINGULARITYENV_LD_LIBRARY_PATH,SINGULARITYENV_LD_PRELOAD'
        singularity.runOptions = '--bind /isabl:/isabl --bind /scratch:/scratch'
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    gcp_slurm {
        process {
            executor = 'slurm'
            queue = 'n2dc64m256'
        }
        executor {
            queueSize = 500
        }
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '--bind /isabl:/isabl --bind /scratch:/scratch'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Export these variables to prevent local Python/R libraries from conflicting
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// The strict config syntax does not allow variable declarations, so the reports use
// fixed names and rely on `overwrite` rather than a timestamp suffix.
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
    overwrite = true
}

manifest {
    name            = 'nf-caveman'
    author          = 'papaemmelab'
    homePage        = 'https://github.com/papaemmelab/nf-caveman'
    description     = 'Nextflow pipeline for CaVEMan somatic SNV calling'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
    doi             = ''
}
